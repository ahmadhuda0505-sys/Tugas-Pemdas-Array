package com.mycompany.arraymultidimensi;

/**
 *
 * @author ahmad
 */
public class empat {
    public static void main(String[] args) {
        int[][] matriks = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };

        int total = 0;

        for (int i = 0; i < matriks.length; i++) {
            total += matriks[i][i];
        }

        System.out.println("Jumlah diagonal utama: " + total);
    }
}

