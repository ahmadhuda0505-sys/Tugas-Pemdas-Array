package com.mycompany.arraymultidimensi;

/**
 *
 * @author ahmad
 */
public class sembilan {
   public static void main(String[] args) {
        String angka = "1234567";

        StringBuilder hasil = new StringBuilder(angka);

        for (int i = hasil.length() - 3; i > 0; i -= 3) {
            hasil.insert(i, ".");
        }

        System.out.println("Angka awal: " + angka);
        System.out.println("Hasil: " + hasil);
    }  
}
